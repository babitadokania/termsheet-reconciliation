# Copy this file to .env and fill in your key:   copy .env.example .env   (Windows)  |  cp .env.example .env
# .env is git-ignored - never commit real keys.

# Free key from Google AI Studio: https://aistudio.google.com/app/apikey
# AI Studio keys ("AIza..." or "AQ...") use the free Gemini Developer API - no billing needed.
GEMINI_API_KEY=
# Set to true only for a Vertex AI key on a billing-enabled Google Cloud project.
GEMINI_USE_VERTEX=false

# auto = Gemini when GEMINI_API_KEY is set, otherwise the offline mock | gemini | mock
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-3.8-flash
# Groq (free, no billing): https://console.groq.com/keys  -> use with --provider groq
GROQ_API_KEY=
# GROQ_MODEL=               # optional; default = best available free-tier model

# Optional tuning
# LLM_TEMPERATURE=0.0
# LLM_MAX_RETRIES=5
# LLM_TIMEOUT_S=120
# LLM_MIN_INTERVAL_S=4.0        # seconds between Gemini calls (free tier rate limit)
# LLM_USE_CACHE=true            # reuse responses for unchanged inputs (output/llm_cache)
# EXTRACTION_FALLBACK=true      # use the regex extractor if Gemini is unavailable
# TERM_SHEET_DIR=data/term_sheets
# BOOKING_DIR=data/bookings
# OUTPUT_DIR=output
# NUMERIC_TOLERANCE=1e-6
# SPARK_MASTER=local[*]
# LOG_LEVEL=INFO
